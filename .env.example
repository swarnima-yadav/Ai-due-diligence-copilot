# ---- Choose ONE provider: gemini | openai | groq | openrouter | ollama | openai_compatible | anthropic
LLM_PROVIDER=gemini

# For gemini / openai / groq / openrouter / openai_compatible:
LLM_API_KEY=paste_your_key_here
# Optional overrides (sensible defaults exist for each provider):
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=

# For LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=your_key_here
# CLAUDE_MODEL=claude-sonnet-5-5

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5500,http://localhost:5500
MAX_UPLOAD_MB=50
AI_RATE_PER_MIN=10
